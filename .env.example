# Example only. Never commit real credentials.
MODEL_API_KEY=replace-with-your-own-key
META_API_BASE_URL=https://api.meta.ai/v1
DATABASE_PATH=./data/proofflow.sqlite
STORAGE_PATH=./data/private
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Published container port; independent of the API port used by local dev.
PROOFFLOW_HTTP_PORT=3000
# Use 0.0.0.0 for remote access; keep loopback for a proxy on the Docker host.
PROOFFLOW_BIND_IP=127.0.0.1
# For containers, set this to the exact public URL, including https:// when used.
WEB_ORIGIN=http://localhost:5173
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Private demo folder; every trigger replays its selected file from the beginning.
DEMO_VIDEO_PATH=./data/demos
# Server-only named streams. Never put camera credentials in frontend settings.
CAMERA_SOURCES={}
